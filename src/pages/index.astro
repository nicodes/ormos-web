---
import Full from '../layouts/Full.astro';
---

<Full>
	<div class="folio">
		<header class="topbar">
			<a class="wordmark" href="/">
				ormos
			</a>
			<nav aria-label="Main">
				<a href="#start">Install</a>
				<a href="https://github.com/nicodes/ormos#readme">Documentation ↗</a>
			</nav>
		</header>
		<main id="main-content">
			<section class="workspace-cover">
				<div class="workspace-intro">
					<p class="tag">YOUR MACHINE. A WINDOW INTO IT.</p>
					<h1>
						Home is where
						<br />
						<em>your shell is.</em>
					</h1>
					<p>
						A browser workspace for real terminals and localhost apps. One executable on your machine. The tools and
						files you already use.
					</p>
					<a class="cta" href="#start">
						Open your workspace <span>↘</span>
					</a>
				</div>
				<div class="workspace-tour">
					<div class="tour-bar">
						<span class="tour-dots">● ● ●</span>
						<span>ORMOS / ILLUSTRATIVE WORKSPACE</span>
						<span>LOCAL</span>
					</div>
					<div class="tour-tabs">
						<input type="radio" name="workspace-view" id="terminal-view" checked />
						<label for="terminal-view">01 Terminal</label>
						<input type="radio" name="workspace-view" id="preview-view" />
						<label for="preview-view">02 Preview</label>
						<div class="tour-content">
							<div class="terminal-view">
								<div class="terminal-tabs">
									<span>studio</span>
									<span>notes</span>
									<span>+</span>
								</div>
								<pre><span>~/code/studio</span>
$ bun dev

<span>Local: http://localhost:3000/</span>

ready to build something good.

$ ▏</pre>
								<div class="quick-keys">
									<span>Keyboard</span>
									<span>Esc</span>
									<span>Tab</span>
									<span>↑</span>
									<span>↓</span>
									<span>Enter</span>
									<span>Ctrl+C</span>
								</div>
							</div>
							<div class="preview-view">
								<div class="port-bar">
									<span>PREVIEW</span>
									<code>3000 /</code>
									<span>↗</span>
								</div>
								<div class="preview-art">
									<span>YOUR LOCAL APP</span>
									<p>
										A new thing
										<br />
										is taking shape.
									</p>
									<div class="preview-orbit">
										<i></i>
										<b>↗</b>
									</div>
								</div>
							</div>
						</div>
					</div>
					<p class="tour-caption">Switch views to explore the illustration. Open Ormos to use a live workspace.</p>
				</div>
			</section>
			<section class="workspace-path">
				<div>
					<span class="path-mark">⌘</span>
					<h2>Your machine</h2>
					<p>Tools, shells and files</p>
				</div>
				<span class="path-link">↔</span>
				<div>
					<span class="path-mark">▣</span>
					<h2>Your browser</h2>
					<p>Terminals and app previews</p>
				</div>
				<span class="path-link">↔</span>
				<div>
					<span class="path-mark">↗</span>
					<h2>Your other device</h2>
					<p>Private access with Tailscale</p>
				</div>
			</section>
			<section class="card-grid">
				<article>
					<p class="tag">TERMINALS</p>
					<h3>A tab for each thread.</h3>
					<p>
						Independent shells keep running as you switch. Rename tabs, execute saved commands, and paste saved prompts.
					</p>
				</article>
				<article>
					<p class="tag">PREVIEWS</p>
					<h3>Just enter the port.</h3>
					<p>
						Open <code>3000</code>, <code>3000/about</code>, or a localhost URL. Preview forwarding includes WebSockets
						and live reload.
					</p>
				</article>
				<article>
					<p class="tag">PRIVATE ACCESS</p>
					<h3>A way back to your desk.</h3>
					<p>Keep Ormos on loopback. Use Tailscale Serve for access from another device on your private network.</p>
					<a href="https://github.com/nicodes/ormos#private-access-through-tailscale">Set up private access ↗</a>
				</article>
			</section>
			<section class="start" id="start">
				<div>
					<p class="tag">THREE STEPS TO YOUR WORKSPACE</p>
					<h2 class="section-heading">
						Install. Open.
						<br />
						Carry on.
					</h2>
					<p>
						Linux and macOS, x86_64 and arm64. The installer verifies its download and installs to your user bin
						directory without sudo.
					</p>
					<a href="https://github.com/nicodes/ormos/releases">Browse releases ↗</a>
				</div>
				<div class="steps">
					<article>
						<span>01 / INSTALL</span>
						<pre>curl -fsSL https://github.com/nicodes/ormos/raw/main/install.sh | sh</pre>
					</article>
					<article>
						<span>02 / START</span>
						<pre>ormos ui</pre>
					</article>
					<article>
						<span>03 / OPEN</span>
						<p>
							Open the printed address, normally <code>http://127.0.0.1:4242</code>.
						</p>
					</article>
					<p class="access-note">
						Ormos has no application login. Anyone allowed to reach the UI can control its terminals. Keep remote access
						private.
					</p>
				</div>
			</section>
		</main>
		<footer class="bottom">
			<span>ormos / your local workspace</span>
			<nav aria-label="Footer">
				<a href="https://github.com/nicodes/ormos">Source</a>
			</nav>
		</footer>
	</div>
</Full>
<style>
	* {
		box-sizing: border-box;
	}
	a {
		color: inherit;
		text-underline-offset: 5px;
	}
	img {
		max-width: 100%;
	}
	svg {
		max-width: 100%;
	}
	h1,
	h2,
	h3,
	p {
		overflow-wrap: break-word;
	}
	h1,
	h2,
	h3 {
		text-wrap: balance;
	}
	p {
		line-height: 1.7;
	}
	code,
	pre {
		font-family: var(--mono);
	}
	pre {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.folio {
		width: min(1200px, calc(100% - 64px));
		margin: auto;
	}
	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		min-height: 100px;
	}
	.wordmark {
		font-size: 23px;
		font-weight: 750;
		letter-spacing: -0.04em;
		text-decoration: none;
	}
	.topbar nav {
		display: flex;
		gap: 25px;
		align-items: center;
		font-size: 12px;
	}
	.topbar nav a {
		text-decoration: none;
	}
	.tag {
		font: 11px var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding: 18px 25px;
		font-size: 14px;
		font-weight: 650;
		text-decoration: none;
		border-radius: 4px;
	}
	.bottom {
		padding: 35px 0;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		align-items: center;
		font-size: 12px;
		border-top: 1px solid var(--line);
	}
	.bottom nav {
		display: flex;
		gap: 20px;
	}
	.section-heading {
		font-size: clamp(32px, 4vw, 52px);
		letter-spacing: -0.04em;
		font-weight: 550;
		line-height: 1.1;
	}
	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 25px;
	}
	.card-grid h3 {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.025em;
	}
	.card-grid p {
		font-size: 14px;
	}
	.icon svg {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}
	details summary {
		cursor: pointer;
		padding: 20px 0;
		font-size: 16px;
	}
	details {
		border-top: 1px solid var(--line);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13px;
	}
	th,
	td {
		text-align: left;
		padding: 15px;
		border-bottom: 1px solid var(--line);
		overflow-wrap: anywhere;
	}
	th {
		font-weight: 600;
	}
	main > section {
		margin-bottom: 100px;
	}
	.source-label {
		font: 10px var(--mono);
		letter-spacing: 0.06em;
	}
	a:focus-visible,
	summary:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 5px;
	}
	@media (max-width: 900px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
		main > section {
			margin-bottom: 70px;
		}
	}
	@media (max-width: 600px) {
		.folio {
			width: calc(100% - 36px);
		}
		.topbar {
			min-height: 85px;
			gap: 16px;
			flex-wrap: wrap;
			padding: 20px 0;
		}
		.topbar nav {
			gap: 16px;
			font-size: 11px;
		}
		.wordmark {
			font-size: 21px;
		}
		.bottom {
			flex-wrap: wrap;
		}
		.cta {
			padding: 16px 20px;
		}
		th,
		td {
			padding: 12px 7px;
			font-size: 11px;
		}
		main > section {
			margin-bottom: 55px;
		}
	}
	.workspace-cover {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 60px;
		align-items: center;
		padding: 45px 0;
	}
	.workspace-intro h1 {
		font-family: Georgia, serif;
		font-family: Georgia, serif;
		font-size: clamp(52px, 5.5vw, 78px);
		font-weight: 550;
		line-height: 1.05;
		letter-spacing: -0.05em;
		margin: 30px 0;
	}
	.workspace-intro em {
		font-family: Georgia, serif;
		font-style: normal;
		font-weight: 400;
		color: #716080;
	}
	.workspace-intro > p:last-of-type {
		font-size: 18px;
		color: #756e7a;
		max-width: 430px;
	}
	.cta {
		background: #675075;
		color: white;
	}
	.workspace-tour {
		min-width: 0;
		background: #ddd5e0;
		border-radius: 12px;
		padding: 12px;
		box-shadow: 0 30px 55px #56466120;
		border: 1px solid #c7bccf;
		transform: rotate(1deg);
	}
	.tour-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 8px;
		font: 8px var(--mono);
		color: #655570;
		padding: 8px 5px 18px;
	}
	.tour-dots {
		color: #a18aa9;
		font-size: 11px;
		white-space: nowrap;
	}
	.tour-tabs {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
		position: relative;
	}
	.tour-tabs input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
	}
	.tour-tabs label {
		font: 11px var(--mono);
		padding: 14px 20px;
		cursor: pointer;
		color: #75617f;
		border-radius: 6px 6px 0 0;
	}
	.tour-tabs input:checked + label {
		color: #f2f0e7;
		background: #302b37;
	}
	.tour-tabs input:focus-visible + label {
		outline: 3px solid #675075;
		outline-offset: 3px;
	}
	.tour-content {
		width: 100%;
		min-height: 360px;
		background: #302b37;
		color: #ede7f0;
		border-radius: 0 6px 6px 6px;
		overflow: hidden;
	}
	.terminal-tabs {
		display: flex;
		gap: 22px;
		font: 10px var(--mono);
		padding: 17px 24px;
		border-bottom: 1px solid #4f415a;
	}
	.terminal-tabs > span:first-child {
		color: #cbadcf;
	}
	.terminal-view pre {
		font-size: 13px;
		line-height: 1.9;
		padding: 20px 25px;
		margin: 0;
		min-height: 280px;
	}
	.terminal-view pre span {
		color: #c1d8a7;
	}
	.quick-keys {
		padding: 16px;
		display: flex;
		gap: 9px;
		flex-wrap: wrap;
		background: #3a3243;
	}
	.quick-keys > span {
		font: 9px var(--mono);
		padding: 8px;
		background: #51445b;
		border-radius: 3px;
	}
	.preview-view {
		display: none;
		background: #fbf8f0;
		color: #63526f;
		min-height: 360px;
	}
	.port-bar {
		display: flex;
		justify-content: space-between;
		padding: 18px 24px;
		border-bottom: 1px solid #e6ddec;
		font: 10px var(--mono);
	}
	.preview-art {
		padding: 28px;
		position: relative;
		min-height: 320px;
		overflow: hidden;
	}
	.preview-art > span {
		font: 9px var(--mono);
		letter-spacing: 0.12em;
	}
	.preview-art > p {
		font:
			42px/1.1 Georgia,
			serif;
		margin-top: 28px;
		position: relative;
		z-index: 1;
	}
	.preview-orbit {
		width: 190px;
		height: 190px;
		position: absolute;
		right: -12px;
		bottom: -45px;
		border-radius: 50%;
		border: 1px solid #ccb4d8;
		background: #e3d4e6;
		display: grid;
		place-items: center;
	}
	.preview-orbit i {
		width: 140px;
		height: 140px;
		border-radius: 50%;
		border: 1px solid #ccb4d8;
		position: absolute;
	}
	.preview-orbit b {
		font:
			75px Georgia,
			serif;
		font-weight: 400;
	}
	#preview-view:checked ~ .tour-content .terminal-view {
		display: none;
	}
	#preview-view:checked ~ .tour-content .preview-view {
		display: block;
	}
	.tour-caption {
		font: 9px/1.6 var(--mono);
		color: #75617f;
		padding: 4px 5px 0;
	}
	.workspace-path {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: #e4dfd4;
		padding: 35px;
		gap: 20px;
		border-radius: 8px;
	}
	.workspace-path h2 {
		font-size: 19px;
		margin: 15px 0 8px;
		font-weight: 550;
	}
	.workspace-path p {
		font-size: 12px;
		color: #756e7a;
		margin: 0;
	}
	.path-mark {
		font-size: 32px;
		color: #786487;
	}
	.path-link {
		font-size: 25px;
		color: #a197a8;
	}
	.card-grid article {
		border-top: 1px solid var(--line);
		padding-top: 20px;
	}
	.card-grid p {
		color: #756e7a;
	}
	.card-grid a {
		font-size: 12px;
		color: #675075;
	}
	.start {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
		padding: 45px;
		background: #e5dce8;
		border-radius: 10px;
	}
	.start p {
		color: #756e7a;
		font-size: 14px;
	}
	.start a {
		font-size: 12px;
	}
	.steps article {
		padding: 20px 0;
		border-top: 1px solid #c5b7d0;
	}
	.steps article > span {
		font: 9px var(--mono);
		color: #786487;
	}
	.steps pre {
		font-size: 12px;
		line-height: 1.8;
	}
	.access-note {
		font-size: 11px !important;
		border-top: 1px solid #c5b7d0;
		padding-top: 20px;
	}
	@media (max-width: 900px) {
		.workspace-cover {
			grid-template-columns: 1fr;
			gap: 40px;
		}
		.workspace-intro {
			max-width: 650px;
		}
		.workspace-tour {
			transform: none;
		}
		.start {
			gap: 35px;
		}
		.workspace-path {
			padding: 25px;
			gap: 15px;
		}
		.workspace-path h2 {
			font-size: 16px;
		}
	}
	@media (max-width: 600px) {
		.workspace-cover {
			padding-top: 20px;
		}
		.workspace-intro h1 {
			font-family: Georgia, serif;
			font-family: Georgia, serif;
			font-size: 55px;
		}
		.workspace-intro > p:last-of-type {
			font-size: 16px;
		}
		.tour-bar {
			font-size: 7px;
		}
		.tour-dots {
			font-size: 8px;
		}
		.tour-tabs label {
			padding: 13px 16px;
		}
		.terminal-view pre {
			font-size: 11px;
			padding: 18px;
		}
		.quick-keys {
			padding: 12px;
			gap: 7px;
		}
		.quick-keys > span {
			font-size: 8px;
			padding: 7px;
		}
		.workspace-path {
			flex-direction: column;
			align-items: start;
			padding: 25px;
		}
		.path-link {
			transform: rotate(90deg);
		}
		.workspace-path h2 {
			font-size: 20px;
		}
		.workspace-path p {
			font-size: 13px;
		}
		.start {
			grid-template-columns: 1fr;
			padding: 28px 22px;
			gap: 25px;
		}
		.preview-art > p {
			font-size: 36px;
		}
	}
</style>
